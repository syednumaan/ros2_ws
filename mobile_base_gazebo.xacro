<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_properties.xacro"/>
    
    <gazebo reference="caster_wheel_link">
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>

    </gazebo>
    <gazebo>

        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>base_left_wheel</left_joint>
            <right_joint>base_right_wheel</right_joint>
            <wheel_separation>${base_width+right_wheel_length*2}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>ground</child_frame_id>
        </plugin>
    </gazebo>


    <gazebo>
    
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_right_wheel</joint_name>
            <joint_name>base_left_wheel</joint_name>
            <joint_name>base_caster_joint</joint_name>
        </plugin>
    </gazebo>
</robot>