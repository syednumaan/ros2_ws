<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_properties.xacro"/>
    <xacro:include filename="mobile_base_gazebo.xacro"/>
    <xacro:include filename="camera.xacro"/>


    <xacro:property name="base_length" value="0.5"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>


    <xacro:property name="right_wheel_length" value="0.02"/>
    <xacro:property name="left_wheel_length" value="0.02"/>
    
    
    <xacro:property name="caster_wheel_radius" value="0.05"/>

    <xacro:property name="wheel_radius" value="${2*caster_wheel_radius}"/>
    



    

    <link name="ground"/>
    

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="1" x="${base_length}" y="${base_width}" z="${base_height}" 
                           o_xyz="0 0 0" o_rpy="0 0 0"/>

    </link>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${right_wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" l="${right_wheel_length}" 
                                o_xyz="0 0 0" o_rpy="0 0 0"/>
        
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${left_wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" l="${left_wheel_length}" 
                                o_xyz="0 0 0" o_rpy="0 0 0"/>
        
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:sphere_inertia m="0.2" r="${caster_wheel_radius}" 
                              o_xyz="0 0 0" o_rpy="0 0 0"/>
        
    </link>


    <joint name="ground_base_joint" type="fixed">
        <parent link="ground"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius+base_height/2}" rpy="0 0 0"/>
    </joint>


    <joint name="base_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${0.3*base_length} ${(base_width+right_wheel_length)/2} -${base_height/2}" rpy="${-pi/2} 0 0"/>  
        <axis xyz="0 0 -1"/>
    </joint>

    <joint name="base_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${0.3*base_length} ${(-base_width-left_wheel_length)/2} -${base_height/2}" rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <joint name="base_caster_joint" type="continuous">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="-${(base_length/4)} 0 -${caster_wheel_radius+base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
    </joint>

</robot>