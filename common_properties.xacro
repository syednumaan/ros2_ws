<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.5"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>


    <xacro:property name="right_wheel_length" value="0.02"/>
    <xacro:property name="left_wheel_length" value="0.02"/>
    
    
    <xacro:property name="caster_wheel_radius" value="0.05"/>

    <xacro:property name="wheel_radius" value="${2*caster_wheel_radius}"/>

  

    <material name="blue">
        <color rgba="0.2 0.1 0.9 1"/>
    </material>

    <material name="red">
        <color rgba="0.5 0.1 0.1 1"/>
    </material>

    <material name="yellow">
        <color rgba="1.0 1.0 0.0 1"/>
    </material>

    <material name="orange">
        <color rgba="1.0 0.65 0.0 1"/>
    </material>

    <material name="green">
        <color rgba="0.0 1.0 0.0 1"/>
    </material>

    <material name="purple">
        <color rgba="0.5 0.0 0.5 1"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
    </material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
    
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(m/12)*(y**2 + z**2)}" ixy="0" ixz="0" 
                     iyy="${(m/12)*(x**2 + z**2)}" iyz="0"
                     izz="${(m/12)*(y**2 + x**2)}"/>
        </inertial>
    
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
    
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(1/12)*m*(3*r**2 + l**2)}" ixy="0" ixz="0" 
                     iyy="${(1/12)*m*(3*r**2 + l**2)}" iyz="0"
                     izz="${(1/2)*m*r**2}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
    
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(2/5)*m*r**2}" ixy="0" ixz="0" 
                     iyy="${(2/5)*m*r**2}" iyz="0"
                     izz="${(2/5)*m*r**2}"/>
        </inertial>
        </xacro:macro>
</robot>